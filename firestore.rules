rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Path: users/{userId}/notes/{docId}
    //   Required: id, title, content, _version, _updatedAt, _syncStatus, _updatedBy
    //
    // Path: users/{userId}/events/{docId}
    //   Required: id, title, date, completed, _version, _updatedAt, _syncStatus, _updatedBy
    //
    // Path: users/{userId}/categories/{docId}
    //   Required: id, name, color, _version, _updatedAt, _syncStatus, _updatedBy
    //
    // Path: users/{userId}/schedule/{docId}
    //   Required: id, title, day_of_week, start_time, end_time, _version, _updatedAt, _syncStatus, _updatedBy
    //
    // Path: users/{userId}/quicknotes/{docId}
    //   Required: id, text, color, _version, _updatedAt, _syncStatus, _updatedBy
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasBaseFields() {
      return request.resource.data.keys().hasAll([
        'id', '_version', '_updatedAt', '_syncStatus', '_updatedBy'
      ]);
    }

    function validBaseData(userId) {
      return hasBaseFields() &&
        request.resource.data.id is string &&
        request.resource.data.id.size() > 0 &&
        request.resource.data.id.size() <= 128 &&
        request.resource.data._version is number &&
        request.resource.data._version >= 1 &&
        request.resource.data._syncStatus in ['pending', 'synced', 'error'] &&
        request.resource.data._updatedBy == userId &&
        request.resource.data._updatedAt is timestamp;
    }

    function immutableOwnerFieldsUnchanged(userId) {
      return request.resource.data.id == resource.data.id &&
        request.resource.data._updatedBy == userId;
    }

    function isValidUserProfile(userId) {
      return request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'isAnonymous', 'lastLoginAt', 'createdAt'
        ]) &&
        request.resource.data.uid == userId &&
        (
          request.resource.data.email == null ||
          (request.resource.data.email is string && request.resource.data.email.size() <= 254)
        ) &&
        (
          request.resource.data.displayName == null ||
          (request.resource.data.displayName is string &&
            request.resource.data.displayName.size() > 0 &&
            request.resource.data.displayName.size() <= 80)
        ) &&
        request.resource.data.isAnonymous is bool &&
        request.resource.data.lastLoginAt is timestamp &&
        request.resource.data.createdAt is timestamp;
    }

    function isValidNote(userId) {
      return request.resource.data.keys().hasOnly([
          'id', 'title', 'content', 'category_id',
          '_version', '_updatedAt', '_syncStatus', '_updatedBy'
        ]) &&
        validBaseData(userId) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 120 &&
        request.resource.data.content is string &&
        request.resource.data.content.size() <= 20000 &&
        (!('category_id' in request.resource.data) ||
          (request.resource.data.category_id is string &&
            request.resource.data.category_id.size() > 0 &&
            request.resource.data.category_id.size() <= 128));
    }

    function isValidEvent(userId) {
      return request.resource.data.keys().hasOnly([
          'id', 'title', 'date', 'time', 'type', 'description', 'category_id', 'color',
          'completed', 'reminder_minutes',
          '_version', '_updatedAt', '_syncStatus', '_updatedBy'
        ]) &&
        validBaseData(userId) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 120 &&
        request.resource.data.date is string &&
        request.resource.data.date.matches("^\\d{4}-\\d{2}-\\d{2}$") &&
        request.resource.data.completed is bool &&
        (!('time' in request.resource.data) ||
          (request.resource.data.time is string &&
            request.resource.data.time.matches("^\\d{2}:\\d{2}$"))) &&
        (!('type' in request.resource.data) ||
          (request.resource.data.type is string &&
            request.resource.data.type.size() <= 40)) &&
        (!('description' in request.resource.data) ||
          (request.resource.data.description is string &&
            request.resource.data.description.size() <= 2000)) &&
        (!('category_id' in request.resource.data) ||
          (request.resource.data.category_id is string &&
            request.resource.data.category_id.size() > 0 &&
            request.resource.data.category_id.size() <= 128)) &&
        (!('color' in request.resource.data) ||
          (request.resource.data.color is string &&
            request.resource.data.color.size() > 0 &&
            request.resource.data.color.size() <= 32)) &&
        (!('reminder_minutes' in request.resource.data) ||
          (request.resource.data.reminder_minutes is number &&
            request.resource.data.reminder_minutes >= 0 &&
            request.resource.data.reminder_minutes <= 10080));
    }

    function isValidCategory(userId) {
      return request.resource.data.keys().hasOnly([
          'id', 'name', 'color',
          '_version', '_updatedAt', '_syncStatus', '_updatedBy'
        ]) &&
        validBaseData(userId) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 60 &&
        request.resource.data.color is string &&
        request.resource.data.color.size() > 0 &&
        request.resource.data.color.size() <= 32;
    }

    function isValidSchedule(userId) {
      return request.resource.data.keys().hasOnly([
          'id', 'title', 'day_of_week', 'start_time', 'end_time', 'category_id', 'color',
          '_version', '_updatedAt', '_syncStatus', '_updatedBy'
        ]) &&
        validBaseData(userId) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 120 &&
        request.resource.data.day_of_week is number &&
        request.resource.data.day_of_week >= 0 &&
        request.resource.data.day_of_week <= 6 &&
        request.resource.data.start_time is string &&
        request.resource.data.start_time.matches("^\\d{2}:\\d{2}$") &&
        request.resource.data.end_time is string &&
        request.resource.data.end_time.matches("^\\d{2}:\\d{2}$") &&
        (!('category_id' in request.resource.data) ||
          (request.resource.data.category_id is string &&
            request.resource.data.category_id.size() > 0 &&
            request.resource.data.category_id.size() <= 128)) &&
        (!('color' in request.resource.data) ||
          (request.resource.data.color is string &&
            request.resource.data.color.size() > 0 &&
            request.resource.data.color.size() <= 32));
    }

    function isValidQuickNote(userId) {
      return request.resource.data.keys().hasOnly([
          'id', 'text', 'color',
          '_version', '_updatedAt', '_syncStatus', '_updatedBy'
        ]) &&
        validBaseData(userId) &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 5000 &&
        request.resource.data.color is string &&
        request.resource.data.color.size() > 0 &&
        request.resource.data.color.size() <= 32;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(userId);
      allow update: if isOwner(userId) &&
        isValidUserProfile(userId) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /notes/{docId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidNote(userId);
        allow update: if isOwner(userId) && immutableOwnerFieldsUnchanged(userId) && isValidNote(userId);
      }

      match /events/{docId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidEvent(userId);
        allow update: if isOwner(userId) && immutableOwnerFieldsUnchanged(userId) && isValidEvent(userId);
      }

      match /categories/{docId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidCategory(userId);
        allow update: if isOwner(userId) && immutableOwnerFieldsUnchanged(userId) && isValidCategory(userId);
      }

      match /schedule/{docId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSchedule(userId);
        allow update: if isOwner(userId) && immutableOwnerFieldsUnchanged(userId) && isValidSchedule(userId);
      }

      match /quicknotes/{docId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidQuickNote(userId);
        allow update: if isOwner(userId) && immutableOwnerFieldsUnchanged(userId) && isValidQuickNote(userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
